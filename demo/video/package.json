    "publish-video": "node scripts/publish-video.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@types/react": "^19.2.0",
    "cf": "^1.0.0-beta.12",
    "typescript": "^5.9.0",
    "wrangler": "^4.147.0"
  }
}
