{
  "name": "codemode-git-deck",
  "private": true,
  "type": "module",
  "description": "The demo as a slide deck: a Code Mode deck agent keeps one program per slide in an Artifacts repo, the presenter renders from it, and you chat with the agent to change slides.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p .",
    "pdf": "node scripts/pdf.mjs",
    "build-slides": "node scripts/build-slides.mjs"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.5.3",
    "@smithclay/codemode-git": "^0.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "wrangler": "^4.149.0"
  }
}
