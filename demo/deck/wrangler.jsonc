{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codemode-git-deck",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One public URL. Cloudflare Access guards /edit and /api/agent on it, which
  // needs a hostname on a zone in the account (workers.dev can't scope Access to paths).
  "routes": [{ "pattern": "deck.clay.gripe", "custom_domain": true }],
  // workers.dev stays on as a view-only mirror: Access sign-in only applies on deck.clay.gripe.
  "workers_dev": true,
  // The presenter is a single page; /api/* goes to the Worker.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/edit"] },
  "durable_objects": {
    "bindings": [{ "name": "DECK", "class_name": "DeckAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeckAgent"] }],
  // The deck-slides and deck-agent repos live in the same namespace as the example agents.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "codemode-git", "remote": true }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "AI", "remote": true },
  // Editing goes through Cloudflare Access: the Access app covering
  // deck.clay.gripe/edit and /api/agent. Without these, only localhost can edit.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "smithclay.cloudflareaccess.com",
    "ACCESS_AUD": "2c750d5b1f7fd6ecfad78fd2024ecd057886c8c9a69aac6ef8fb030958217f4e"
  }
}
