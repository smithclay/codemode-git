{
  "name": "@smithclay/codemode-git",
  "version": "0.1.0",
  "description": "Every Code Mode execution becomes a git commit on a Cloudflare Artifacts repo.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithclay/codemode-git.git",
    "directory": "packages/codemode-git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "isomorphic-git": "^1.30.0"
  },
  "peerDependencies": {
    "@cloudflare/codemode": ">=0.5.0"
  },
  "devDependencies": {
    "@cloudflare/codemode": "^0.5.3",
    "@cloudflare/workers-types": "^5.20260901.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
