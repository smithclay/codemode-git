{
  "name": "codemode-git-demo-video",
  "private": true,
  "type": "module",
  "description": "Demo video for codemode-git: Remotion composition with a Workers AI voiceover (Deepgram Aura-2) and Whisper captions.",
  "scripts": {
    "tts-worker": "cf dev",
    "voiceover": "node scripts/voiceover.mjs",
